{
  "name": "pos-toko-desktop",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "prep": "node -e \"require('fs').cpSync('../www','www',{recursive:true})\"",
    "start": "npm run prep && electron .",
    "dist": "npm run prep && electron-builder --win portable"
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": { "appId": "id.toko.pos", "productName": "POS Toko", "files": ["main.js", "www/**"] }
}
